{
  "info": {
    "name": "TMDB Daily Sync Cron",
    "_postman_id": "a8c3e91f-2b74-4d6a-9f15-6e0d4c8b1a22",
    "description": "PHP-only daily sync admin APIs (no Python).\n\nOrder for local/live test:\n1) Status\n2) Enqueue\n3) Process (repeat until pending=0)\n4) Status again\n\nDefault variables point to **live**:\n- baseUrl: https://app.myappworld.in/tmdb/api\n- apiKey: live Flutter/API key\n\nLocal override: http://localhost/tmdb/api + tmdb_flutter_secret_123\n\nAuth: header X-API-Key = API_KEY or ADMIN_API_KEY\n\nSee CRON.md for cron schedule (2 jobs: enqueue daily + process every 10 min).",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "apikey",
    "apikey": [
      {
        "key": "key",
        "value": "X-API-Key",
        "type": "string"
      },
      {
        "key": "value",
        "value": "{{apiKey}}",
        "type": "string"
      },
      {
        "key": "in",
        "value": "header",
        "type": "string"
      }
    ]
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "https://app.myappworld.in/tmdb/api"
    },
    {
      "key": "apiKey",
      "value": "f3a9d6c1b8e5f27a4d0c9e6b1a7f5d82"
    },
    {
      "key": "processLimit",
      "value": "3"
    },
    {
      "key": "syncDay",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "1. Status",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json",
            "type": "text"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"day\": \"{{syncDay}}\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/admin/sync/status",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "admin",
            "sync",
            "status"
          ]
        },
        "description": "Queue stats for IST today (or optional day).\n\nCheck: engine=php, tmdb_keys, pending/done/failed.\n\nEmpty day string = today (IST)."
      },
      "response": []
    },
    {
      "name": "2. Enqueue",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json",
            "type": "text"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{}"
        },
        "url": {
          "raw": "{{baseUrl}}/admin/sync/enqueue",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "admin",
            "sync",
            "enqueue"
          ]
        },
        "description": "Fill queue for today (IST):\n- movie/tv/person changes ∩ DB\n- discover today + providers_config\n\nCron job #1 — run once daily.\nCan take 1–3 minutes."
      },
      "response": []
    },
    {
      "name": "2b. Enqueue (specific day)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json",
            "type": "text"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"day\": \"2026-08-03\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/admin/sync/enqueue",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "admin",
            "sync",
            "enqueue"
          ]
        },
        "description": "Optional: enqueue for a specific YYYY-MM-DD day."
      },
      "response": []
    },
    {
      "name": "3. Process",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json",
            "type": "text"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"limit\": {{processLimit}}\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/admin/sync/process",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "admin",
            "sync",
            "process"
          ]
        },
        "description": "Process up to `limit` queue items (1–20).\n\nCron job #2 — run every 5–10 minutes until pending=0.\n\nAfter movie/tv sync, related people may be enqueued."
      },
      "response": []
    },
    {
      "name": "4. Run (enqueue + first batch)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json",
            "type": "text"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"limit\": {{processLimit}}\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/admin/sync/run",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "admin",
            "sync",
            "run"
          ]
        },
        "description": "One-shot test: enqueue + process first limit items only.\n\nFor full drain, still call Process repeatedly."
      },
      "response": []
    }
  ]
}
