{
  "info": {
    "name": "TMDB Local API",
    "_postman_id": "d1e2f3a4-b5c6-47d8-9e0f-112233445566",
    "description": "Postman collection for TMDB Local PHP API v1.7.\n\nAll endpoints use POST and require header `X-API-Key`.\nFilters and options go in the JSON body (not query params).\n\nHome: prefer `POST /home/bootstrap` + `POST /home/row` for progressive load; `POST /home/feed` is the full legacy feed.\n\nDefault variables point to **live**:\n- baseUrl: https://app.myappworld.in/tmdb/api\n- apiKey: live Flutter/API key\n\nLocal override: http://localhost/tmdb/api + local API_KEY from api/.env",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "apikey",
    "apikey": [
      {
        "key": "key",
        "value": "X-API-Key",
        "type": "string"
      },
      {
        "key": "value",
        "value": "{{apiKey}}",
        "type": "string"
      },
      {
        "key": "in",
        "value": "header",
        "type": "string"
      }
    ]
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "https://app.myappworld.in/tmdb/api"
    },
