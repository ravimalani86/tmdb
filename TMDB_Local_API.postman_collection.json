    {
      "name": "Admin Sync (Daily Cron)",
      "item": [
        {
          "name": "1. Status",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"day\": \"{{syncDay}}\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/admin/sync/status",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "admin",
                "sync",
                "status"
              ]
            },
            "description": "Queue stats for IST today (or optional `day`).\n\nRequires admin API key (`ADMIN_API_KEY` or same as `API_KEY`).\nEmpty `day` = today (IST)."
          },
          "response": []
        },
        {
          "name": "2. Enqueue",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{}"
            },
            "url": {
              "raw": "{{baseUrl}}/admin/sync/enqueue",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "admin",
                "sync",
                "enqueue"
              ]
            },
            "description": "Fill queue for today (IST):\n- movie/tv/person changes intersect DB\n- discover today + providers_config\n\nCan take 1-3 minutes."
          },
          "response": []
        },
        {
          "name": "2b. Enqueue (specific day)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"day\": \"2026-08-03\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/admin/sync/enqueue",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "admin",
                "sync",
                "enqueue"
              ]
            },
            "description": "Optional: enqueue for a specific YYYY-MM-DD day."
          },
          "response": []
        },
        {
          "name": "3. Process",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"limit\": {{processLimit}}\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/admin/sync/process",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "admin",
                "sync",
                "process"
              ]
            },
            "description": "Process up to `limit` queue items (1-20).\nRepeat until pending=0."
          },
          "response": []
        },
        {
          "name": "4. Run (enqueue + first batch)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"limit\": {{processLimit}}\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/admin/sync/run",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "admin",
                "sync",
                "run"
              ]
            },
            "description": "One-shot test: enqueue + process first `limit` items only.\nFor full drain, still call Process repeatedly."
          },
          "response": []
        }
      ]
    }
  ]
